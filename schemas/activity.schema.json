{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domes-for-dots.example/schemas/activity.schema.json",
  "title": "Domes for Dots activity schema v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "activity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": [
        "work",
        "call"
      ]
    },
    "activity_tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Optional work-lease activity tag. Omit for work; call leases always route to call."
    },
    "operation": {
      "enum": [
        "start",
        "renew",
        "end"
      ]
    },
    "timestamp": {
      "type": "number",
      "minimum": 0
    },
    "ttl_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 60
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "activity_id",
    "source",
    "sequence",
    "kind",
    "operation",
    "timestamp",
    "ttl_seconds",
    "world_id",
    "character_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["activity_tag"] },
      "then": { "properties": { "kind": { "const": "work" } } }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "start",
              "renew"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ttl_seconds": {
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ]
}
