{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domes-for-dots.example/schemas/change-request.schema.json",
  "title": "Dot-authored content change request v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "world_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "intent": {"enum": ["create", "expand"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "base_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "properties": {
          "path": {"type": "string", "pattern": "^godot/content/(worlds|briefs|assets|characters|routines)/[a-z][a-z0-9_]{0,63}\\.json$"},
          "document": {"type": "object"}
        }, "required": ["path", "document"], "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "id", "world_id", "intent", "description", "base_content_hash", "files"],
  "additionalProperties": false
}
